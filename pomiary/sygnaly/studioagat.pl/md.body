sive:!0}),f();</script><main id="tresc"><section class="otwarcie" aria-labelledby="otwarcie-tytul" data-astro-cid-lcdefpme><div class="kontener" data-astro-cid-lcdefpme><h1 id="otwarcie-tytul" class="otwarcie__tytul" data-astro-cid-lcdefpme>Projektant wnętrz Warszawa, architekt wnętrz <span class="otwarcie__podtytul" data-astro-cid-lcdefpme>Kuchnie i meble na wymiar, kompleksowe remonty pod klucz</span></h1><img src="/_astro/strony-glowna-hero-sofa-beton-03.5wkcr7BF_LbXYb.webp" srcset="/_astro/strony-glowna-hero-sofa-beton-03.5wkcr7BF_1nESm8.webp 480w, /_astro/strony-glowna-hero-sofa-beton-03.5wkcr7BF_Z1lLSeQ.webp 680w, /_astro/strony-glowna-hero-sofa-beton-03.5wkcr7BF_2fVPsD.webp 860w, /_astro/strony-glowna-hero-sofa-beton-03.5wkcr7BF_LbXYb.webp 1136w, /_astro/strony-glowna-hero-sofa-beton-03.5wkcr7BF_z6WrT.webp 1600w, /_astro/strony-glowna-hero-sofa-beton-03.5wkcr7BF_ZKUk24.webp 1618w" alt="Ciemnoszara sofa przy betonowej ścianie pod trzema lampami wiszącymi" sizes="(min-width: 75rem) 1136px, (min-width: 48rem) calc(100vw - 64px), calc(100vw - 32px)" loading="eager" fetchpriority="high" data-pelny="/_astro/strony-glowna-hero-sofa-beton-03.5wkcr7BF_ZoPWtY.webp" data-szer="1618" data-wys="1080" data-astro-cid-lcdefpme="true" decoding="async" width="1136" height="676" class="otwarcie__zdjecie"></div></section><section id="projektowanie-wnetrz" class="sekcja sekcja--narracja" aria-labelledby="projektowanie-wnetrz-tytul" data-astro-cid-7p2l4vwq><div class="kontener" data-astro-cid-7p2l4vwq><div class="narracja" data-astro-cid-7p2l4vwq><div class="narracja__tresc" data-astro-cid-7p2l4vwq><h2 id="projektowanie-wnetrz-tytul" class="narracja__tytul" data-astro-cid-7p2l4vwq>Projektowanie wnętrz</h2><p data-astro-cid-7p2l4vwq>Jako projektanci wnętrz przygotowujemy projekty mieszkań, domów i <a href="/biuro-galeria" data-astro-cid-dd7xymsh>biur</a> z rynku pierwotnego oraz wtórnego.</p><p class="narracja__cta" data-astro-cid-7p2l4vwq><a class="guzik guzik--glowny" href="/projektowanie-wnetrz" data-astro-cid-7p2l4vwq>Zobacz, jak projektujemy wnętrza</a></p></div><img src="/_astro/strony-glowna-szkic-kuchni-zagiecie-04.BiI42ToV_Z1BUYTm.webp" srcset="/_astro/strony-glowna-szkic-kuchni-zagiecie-04.BiI42ToV_kgYIJ.webp 480w, /_astro/strony-glowna-szkic-kuchni-zagiecie-04.BiI42ToV_OOKzG.webp 640w, /_astro/strony-glowna-szkic-kuchni-zagiecie-04.BiI42ToV_ZUuvax.webp 800w, /_astro/strony-glowna-szkic-kuchni-zagiecie-04.BiI42ToV_Z1BUYTm.webp 1012w" alt="Ręczny szkic kuchni z zagiętym rogiem kartki odsłaniającym gotowe wnętrze" sizes="(min-width: 75rem) 503px, (min-width: 64rem) calc(50vw - 85px), (min-width: 48rem) calc(100vw - 104px), calc(100vw - 72px)" data-pelny="/_astro/strony-glowna-szkic-kuchni-zagiecie-04.BiI42ToV_Z10jU7U.webp" data-szer="1618" data-wys="1080" data-astro-cid-7p2l4vwq="true" loading="lazy" decoding="async" width="1012" height="602" class="narracja__zdjecie"></div></div></section><section id="kuchnie-na-wymiar" class="sekcja sekcja--narracja" aria-labelledby="kuchnie-na-wymiar-tytul" data-astro-cid-7p2l4vwq><div class="kontener" data-astro-cid-7p2l4vwq><div class="narracja narracja--szara narracja--odwrocona" data-astro-cid-7p2l4vwq><div class="narracja__tresc" data-astro-cid-7p2l4vwq><h2 id="kuchnie-na-wymiar-tytul" class="narracja__tytul" data-astro-cid-7p2l4vwq>Kuchnie na wymiar</h2><p data-astro-cid-7p2l4vwq>Projektujemy i wykonujemy <a href="/kuchnia-na-wymiar" data-astro-cid-dd7xymsh>kuchnie na wymiar</a> dopasowane do instalacji, układu pomieszczenia i sposobu gotowania: od pomiaru, przez projekt, po montaż z regulacją.</p><p class="narracja__cta" data-astro-cid-7p2l4vwq><a class="guzik guzik--glowny" href="/kuchnia-na-wymiar" data-astro-cid-7p2l4vwq>Zobacz kuchnie na wymiar</a></p></div><img src="/_astro/kuchnia-biala-wyspa-drewniany-blat-12.CuvjRQUw_ZvndLK.webp" srcset="/_astro/kuchnia-biala-wyspa-drewniany-blat-12.CuvjRQUw_LMpFR.webp 480w, /_astro/kuchnia-biala-wyspa-drewniany-blat-12.CuvjRQUw_Z1SkQBw.webp 640w, /_astro/kuchnia-biala-wyspa-drewniany-blat-12.CuvjRQUw_1AjppJ.webp 800w, /_astro/kuchnia-biala-wyspa-drewniany-blat-12.CuvjRQUw_ZvndLK.webp 1012w" alt="Biała kuchnia z wyspą z wysuniętym drewnianym blatem i okapem wyspowym, w tle jadalnia" sizes="(min-width: 75rem) 503px, (min-width: 64rem) calc(50vw - 85px), (min-width: 48rem) calc(100vw - 104px), calc(100vw - 72px)" data-pelny="/_astro/kuchnia-biala-wyspa-drewniany-blat-12.CuvjRQUw_1befsv.webp" data-szer="1618" data-wys="1080" data-astro-cid-7p2l4vwq="true" loading="lazy" decoding="async" width="1012" height="602" class="narracja__zdjecie"></div></div></section><section id="nadzor-inwestorski" class="sekcja sekcja--narracja" aria-labelledby="nadzor-inwestorski-tytul" data-astro-cid-7p2l4vwq><div class="kontener" data-astro-cid-7p2l4vwq><div class="narracja" data-astro-cid-7p2l4vwq><div class="narracja__tresc" data-astro-cid-7p2l4vwq><h2 id="nadzor-inwestorski-tytul" class="narracja__tytul" data-astro-cid-7p2l4vwq>Nadzór Inwestorski</h2><p data-astro-cid-7p2l4vwq>Świadczymy usługę nadzoru nad naszymi oraz zewnętrznymi projektami aby zagwarantować zgodność z założeniami. Oraz prowadzimy dokumentację zdjęciową inwestycji.</p><p class="narracja__cta" data-astro-cid-7p2l4vwq><a class="guzik guzik--glowny" href="/nadzor-inwestorski" data-astro-cid-7p2l4vwq>Dlaczego warto zlecić nadzór</a></p></div><img src="/_astro/strony-glowna-nadzor-plany-laptop-05.dyTL5xoC_1yNglr.webp" srcset="/_astro/strony-glowna-nadzor-plany-laptop-05.dyTL5xoC_18aJiI.webp 480w, /_astro/strony-glowna-nadzor-plany-laptop-05.dyTL5xoC_Z2seCrH.webp 640w, /_astro/strony-glowna-nadzor-plany-laptop-05.dyTL5xoC_Z2poiHz.webp 800w, /_astro/strony-glowna-nadzor-plany-laptop-05.dyTL5xoC_1yNglr.webp 1012w" alt="Dwie osoby w kamizelkach odblaskowych omawiają plany przy laptopie, na stole model domu" sizes="(min-width: 75rem) 503px, (min-width: 64rem) calc(50vw - 85px), (min-width: 48rem) calc(100vw - 104px), calc(100vw - 72px)" data-pelny="/_astro/strony-glowna-nadzor-plany-laptop-05.dyTL5xoC_Z1hCkAY.webp" data-szer="1618" data-wys="1080" data-astro-cid-7p2l4vwq="true" loading="lazy" decoding="async" width="1012" height="602" class="narracja__zdjecie"></div></div></section><section id="remonty" class="sekcja sekcja--narracja" aria-labelledby="remonty-tytul" data-astro-cid-7p2l4vwq><div class="kontener" data-astro-cid-7p2l4vwq><div class="narracja narracja--szara narracja--odwrocona" data-astro-cid-7p2l4vwq><div class="narracja__tresc" data-astro-cid-7p2l4vwq><h2 id="remonty-tytul" class="narracja__tytul" data-astro-cid-7p2l4vwq>Remonty pod klucz</h2><p data-astro-cid-7p2l4vwq>Nasza firma działa na rynku od kilkunastu lat, w tym czasie zrealizowaliśmy wiele <a href="/projekty" data-astro-cid-dd7xymsh>projektów mieszkań i lokali usługowych</a>, zdobywając zaufanie klientów i cenne doświadczenie.</p><p data-astro-cid-7p2l4vwq>Orientacyjny koszt robocizny przy swoim remoncie policzysz w bezpłatnym <a href="/kalkulator-prac-dla-wykonawcow" data-astro-cid-dd7xymsh>kalkulatorze prac remontowych</a>.</p><p data-astro-cid-7p2l4vwq>Na czas i solidnie: harmonogram prac ustalamy przy podpisaniu <a href="/umowa" data-astro-cid-dd7xymsh>umowy</a>, a usterki wpisane do protokołu odbioru poprawiamy przed zakończeniem prac.</p><p class="narracja__cta" data-astro-cid-7p2l4vwq><a class="guzik guzik--glowny" href="/galeria-prac" data-astro-cid-7p2l4vwq>Zobacz realizacje remontów</a></p></div><img src="/_astro/strony-glowna-remont-plytki-heksagonalne-06.3tLFZthS_1xvDiL.webp" srcset="/_astro/strony-glowna-remont-plytki-heksagonalne-06.3tLFZthS_nXIXo.webp 480w, /_astro/strony-glowna-remont-plytki-heksagonalne-06.3tLFZthS_Z2tb6d8.webp 640w, /_astro/strony-glowna-remont-plytki-heksagonalne-06.3tLFZthS_xahIi.webp 800w, /_astro/strony-glowna-remont-plytki-heksagonalne-06.3tLFZthS_1xvDiL.webp 1012w" alt="Fachowiec układa heksagonalne płytki obok jasnej podłogi z desek, widok z góry" sizes="(min-width: 75rem) 503px, (min-width: 64rem) calc(50vw - 85px), (min-width: 48rem) calc(100vw - 104px), calc(100vw - 72px)" data-pelny="/_astro/strony-glowna-remont-plytki-heksagonalne-06.3tLFZthS_Z1RQzl5.webp" data-szer="1618" data-wys="1080" data-astro-cid-7p2l4vwq="true" loading="lazy" decoding="async" width="1012" height="602" class="narracja__zdjecie"></div></div></section><section id="meble-na-wymiar" class="sekcja sekcja--narracja" aria-labelledby="meble-na-wymiar-tytul" data-astro-cid-7p2l4vwq><div class="kontener" data-astro-cid-7p2l4vwq><div class="narracja" data-astro-cid-7p2l4vwq><div class="narracja__tresc" data-astro-cid-7p2l4vwq><h2 id="meble-na-wymiar-tytul" class="narracja__tytul" data-astro-cid-7p2l4vwq>Meble na wymiar</h2><p data-astro-cid-7p2l4vwq>U nas to nie „mniej więcej”, tylko milimetr po milimetrze, dokładnie tak, jak ma być. Nie zgadujemy, nie upraszczamy. Mierzymy, liczymy, montujemy z precyzją. Terminy traktujemy jak techniczne założenia, jesteśmy na czas.</p><p data-astro-cid-7p2l4vwq>Wykonujemy <a href="/kuchnia-na-wymiar" data-astro-cid-dd7xymsh>kuchnie na wymiar</a>, <a href="/garderoby-szafy-galeria" data-astro-cid-dd7xymsh>garderoby i szafy</a> oraz <a href="/lazienka-galeria" data-astro-cid-dd7xymsh>meble łazienkowe</a>. W cenie każdego z nich jest bezpłatna regulacja po obciążeniu, do trzech miesięcy od odbioru, na zgłoszenie.</p><p class="narracja__cta" data-astro-cid-7p2l4vwq><a class="guzik guzik--glowny" href="/meble-na-wymiar" data-astro-cid-7p2l4vwq>Zobacz meble na wymiar</a></p></div><img src="/_astro/strony-glowna-meble-montaz-polki-07.s8LDqGXY_1YnTGq.webp" srcset="/_astro/strony-glowna-meble-montaz-polki-07.s8LDqGXY_2fGBM3.webp 480w, /_astro/strony-glowna-meble-montaz-polki-07.s8LDqGXY_1TAkwV.webp 640w, /_astro/strony-glowna-meble-montaz-polki-07.s8LDqGXY_cARg7.webp 800w, /_astro/strony-glowna-meble-montaz-polki-07.s8LDqGXY_1YnTGq.webp 1012w" alt="Monter w koszulce z logo Studio Agat montuje półkę w jasnej zabudowie" sizes="(min-width: 75rem) 503px, (min-width: 64rem) calc(50vw - 85px), (min-width: 48rem) calc(100vw - 104px), calc(100vw - 72px)" data-pelny="/_astro/strony-glowna-meble-montaz-polki-07.s8LDqGXY_Z110Oin.webp" data-szer="1618" data-wys="1080" data-astro-cid-7p2l4vwq="true" loading="lazy" decoding="async" width="1012" height="602" class="narracja__zdjecie"></div></div></section><section id="jakosc" class="sekcja sekcja--narracja" aria-labelledby="jakosc-tytul" data-astro-cid-7p2l4vwq><div class="kontener" data-astro-cid-7p2l4vwq><div class="narracja narracja--szara narracja--odwrocona" data-astro-cid-7p2l4vwq><div class="narracja__tresc" data-astro-cid-7p2l4vwq><h2 id="jakosc-tytul" class="narracja__tytul" data-astro-cid-7p2l4vwq>Jakość, która się opłaca, inwestuj na lata.</h2><p data-astro-cid-7p2l4vwq>Stawiamy na jakość, która zostaje na lata: sprawdzone materiały, dokładny montaż i terminy, których dotrzymujemy.</p><p data-astro-cid-7p2l4vwq>Kompleksowa realizacja, czyli <a href="/projektowanie-wnetrz" data-astro-cid-dd7xymsh>projekt</a>, remont i <a href="/meble-na-wymiar" data-astro-cid-dd7xymsh>meble na wymiar</a> u jednego wykonawcy, w sumie wychodzi taniej i kosztuje mniej nerwów. Za całość odpowiada jedna firma, więc nikt nie przerzuca winy na inną ekipę, nie ma pustych dni między etapami ani poprawek po cudzych błędach, a materiały kupujemy raz i dobrze.</p><p class="narracja__cta" data-astro-cid-7p2l4vwq><a class="guzik guzik--glowny" href="/jakosc" data-astro-cid-7p2l4vwq>Nasza filozofia jakości</a></p></div><img src="/_astro/strony-glowna-jakosc-suwmiarka-zawor-08.75pH2pSh_ZXqRkO.webp" srcset="/_astro/strony-glowna-jakosc-suwmiarka-zawor-08.75pH2pSh_Z1GqPUi.webp 480w, /_astro/strony-glowna-jakosc-suwmiarka-zawor-08.75pH2pSh_BGL7z.webp 640w, /_astro/strony-glowna-jakosc-suwmiarka-zawor-08.75pH2pSh_Z122350.webp 800w, /_astro/strony-glowna-jakosc-suwmiarka-zawor-08.75pH2pSh_ZXqRkO.webp 1012w" alt="Pomiar mosiężnej złączki suwmiarką obok zaworu z czerwonym motylkiem" sizes="(min-width: 75rem) 503px, (min-width: 64rem) calc(50vw - 85px), (min-width: 48rem) calc(100vw - 104px), calc(100vw - 72px)" data-pelny="/_astro/strony-glowna-jakosc-suwmiarka-zawor-08.75pH2pSh_1GlLvK.webp" data-szer="1618" data-wys="1080" data-astro-cid-7p2l4vwq="true" loading="lazy" decoding="async" width="1012" height="602" class="narracja__zdjecie"></div></div></section><section id="umowa" class="sekcja sekcja--narracja" aria-labelledby="umowa-tytul" data-astro-cid-7p2l4vwq><div class="kontener" data-astro-cid-7p2l4vwq><div class="narracja" data-astro-cid-7p2l4vwq><div class="narracja__tresc" data-astro-cid-7p2l4vwq><h2 id="umowa-tytul" class="narracja__tytul" data-astro-cid-7p2l4vwq>Umowa</h2><p data-astro-cid-7p2l4vwq>Umowa to gwarancja jasno określonych zasad, terminów i kosztów, dzięki niej obie strony wiedzą, na czym stoją.</p><p class="narracja__cta" data-astro-cid-7p2l4vwq><a class="guzik guzik--glowny" href="/umowa" data-astro-cid-7p2l4vwq>Zasady umowy</a></p></div><img src="/_astro/strony-glowna-umowa-podpis-09.C3qA1zyq_Z7sY0t.webp" srcset="/_astro/strony-glowna-umowa-podpis-09.C3qA1zyq_1s1AT1.webp 480w, /_astro/strony-glowna-umowa-podpis-09.C3qA1zyq_1Rgry9.webp 640w, /_astro/strony-glowna-umowa-podpis-09.C3qA1zyq_Z1oQJG9.webp 800w, /_astro/strony-glowna-umowa-podpis-09.C3qA1zyq_Z7sY0t.webp 1012w" alt="Podpisywanie umowy długopisem przy biurku, dłonie nad białą kartką dokumentu" sizes="(min-width: 75rem) 503px, (min-width: 64rem) calc(50vw - 85px), (min-width: 48rem) calc(100vw - 104px), calc(100vw - 72px)" data-pelny="/_astro/strony-glowna-umowa-podpis-09.C3qA1zyq_ZadA8J.webp" data-szer="1618" data-wys="1080" data-astro-cid-7p2l4vwq="true" loading="lazy" decoding="async" width="1012" height="602" class="narracja__zdjecie"></div></div></section><section id="gwarancja" class="sekcja sekcja--narracja" aria-labelledby="gwarancja-tytul" data-astro-cid-7p2l4vwq><div class="kontener" data-astro-cid-7p2l4vwq><div class="narracja narracja--szara narracja--odwrocona" data-astro-cid-7p2l4vwq><div class="narracja__tresc" data-astro-cid-7p2l4vwq><h2 id="gwarancja-tytul" class="narracja__tytul" data-astro-cid-7p2l4vwq>Gwarancja</h2><p data-astro-cid-7p2l4vwq>Gwarancja to pewność, że wykonana praca będzie trwała i bezproblemowa, bo za jakość usług bierzemy odpowiedzialność.</p><p class="narracja__cta" data-astro-cid-7p2l4vwq><a class="guzik guzik--glowny" href="/gwarancja" data-astro-cid-7p2l4vwq>Zakres gwarancji</a></p></div><img src="/_astro/strony-glowna-gwarancja-pieczatka-10.CmCvU5TV_1XeH5a.webp" srcset="/_astro/strony-glowna-gwarancja-pieczatka-10.CmCvU5TV_9UsHW.webp 480w, /_astro/strony-glowna-gwarancja-pieczatka-10.CmCvU5TV_1DHeLs.webp 640w, /_astro/strony-glowna-gwarancja-pieczatka-10.CmCvU5TV_1GxyvA.webp 800w, /_astro/strony-glowna-gwarancja-pieczatka-10.CmCvU5TV_1XeH5a.webp 1012w" alt="Przybijanie pieczątki na wydrukowanym dokumencie leżącym na biurku obok otwartego laptopa" sizes="(min-width: 75rem) 503px, (min-width: 64rem) calc(50vw - 85px), (min-width: 48rem) calc(100vw - 104px), calc(100vw - 72px)" data-pelny="/_astro/strony-glowna-gwarancja-pieczatka-10.CmCvU5TV_ZSbSRg.webp" data-szer="1618" data-wys="1080" data-astro-cid-7p2l4vwq="true" loading="lazy" decoding="async" width="1012" height="602" class="narracja__zdjecie"></div></div></section><section id="ubezpieczenie" class="sekcja sekcja--narracja" aria-labelledby="ubezpieczenie-tytul" data-astro-cid-7p2l4vwq><div class="kontener" data-astro-cid-7p2l4vwq><div class="narracja" data-astro-cid-7p2l4vwq><div class="narracja__tresc" data-astro-cid-7p2l4vwq><h2 id="ubezpieczenie-tytul" class="narracja__tytul" data-astro-cid-7p2l4vwq>Ubezpieczenie</h2><p data-astro-cid-7p2l4vwq>Ubezpieczenie to spokój ducha na każdym etapie prac, bo bezpieczeństwo Twojego domu i inwestycji jest dla nas priorytetem.</p><p class="narracja__cta" data-astro-cid-7p2l4vwq><a class="guzik guzik--glowny" href="/ubezpieczenie" data-astro-cid-7p2l4vwq>Nasze ubezpieczenia</a></p></div><img src="/_astro/strony-glowna-ubezpieczenie-dlonie-dom-11.DXCD0oDk_Z1S6b7K.webp" srcset="/_astro/strony-glowna-ubezpieczenie-dlonie-dom-11.DXCD0oDk_byAXn.webp 480w, /_astro/strony-glowna-ubezpieczenie-dlonie-dom-11.DXCD0oDk_JjR39.webp 640w, /_astro/strony-glowna-ubezpieczenie-dlonie-dom-11.DXCD0oDk_ZoMV1y.webp 800w, /_astro/strony-glowna-ubezpieczenie-dlonie-dom-11.DXCD0oDk_Z1S6b7K.webp 1012w" alt="Dłonie obejmujące symbol domu, rodziny i samochodu na niebieskim tle" sizes="(min-width: 75rem) 503px, (min-width: 64rem) calc(50vw - 85px), (min-width: 48rem) calc(100vw - 104px), calc(100vw - 72px)" data-pelny="/_astro/strony-glowna-ubezpieczenie-dlonie-dom-11.DXCD0oDk_Z2vSW4M.webp" data-szer="1618" data-wys="1080" data-astro-cid-7p2l4vwq="true" loading="lazy" decoding="async" width="1012" height="602" class="narracja__zdjecie"></div></div></section><section id="produkty-i-materialy" class="sekcja sekcja--narracja" aria-labelledby="produkty-i-materialy-tytul" data-astro-cid-7p2l4vwq><div class="kontener" data-astro-cid-7p2l4vwq><div class="narracja narracja--szara narracja--odwrocona" data-astro-cid-7p2l4vwq><div class="narracja__tresc" data-astro-cid-7p2l4vwq><h2 id="produkty-i-materialy-tytul" class="narracja__tytul" data-astro-cid-7p2l4vwq>Wysokiej jakości produkty i materiały</h2><p data-astro-cid-7p2l4vwq>Korzystamy tylko ze sprawdzonych materiałów i produktów renomowanych marek, aby zapewnić trwałość i estetykę na lata.</p><p class="narracja__cta" data-astro-cid-7p2l4vwq><a class="guzik guzik--glowny" href="/produkty-i-materialy" data-astro-cid-7p2l4vwq>Sprawdź marki materiałów</a></p></div><img src="/_astro/strony-glowna-materialy-probki-12.BulyQLh3_2oXeSl.webp" srcset="/_astro/strony-glowna-materialy-probki-12.BulyQLh3_Z22Bzcc.webp 480w, /_astro/strony-glowna-materialy-probki-12.BulyQLh3_ZcTe50.webp 640w, /_astro/strony-glowna-materialy-probki-12.BulyQLh3_LHOjO.webp 800w, /_astro/strony-glowna-materialy-probki-12.BulyQLh3_2oXeSl.webp 1012w" alt="Dłonie dobierają próbki płyt i tkanin rozłożone na drewnianym stole" sizes="(min-width: 75rem) 503px, (min-width: 64rem) calc(50vw - 85px), (min-width: 48rem) calc(100vw - 104px), calc(100vw - 72px)" data-pelny="/_astro/strony-glowna-materialy-probki-12.BulyQLh3_1TA3VG.webp" data-szer="1618" data-wys="1080" data-astro-cid-7p2l4vwq="true" loading="lazy" decoding="async" width="1012" height="602" class="narracja__zdjecie"></div></div></section><section id="oferujemy" class="sekcja sekcja--narracja" aria-labelledby="oferujemy-tytul" data-astro-cid-7p2l4vwq><div class="kontener" data-astro-cid-7p2l4vwq><div class="narracja narracja--ciemna" data-astro-cid-7p2l4vwq><div class="narracja__tresc" data-astro-cid-7p2l4vwq><h2 id="oferujemy-tytul" class="narracja__tytul" data-astro-cid-7p2l4vwq>Jako biuro projektowe oferujemy:</h2><ul class="narracja__lista" data-astro-cid-7p2l4vwq><li data-astro-cid-7p2l4vwq>Indywidualne projekty wnętrz mieszkań i domów jednorodzinnych</li><li data-astro-cid-7p2l4vwq>Pełen nadzór autorski na każdym etapie remontu</li><li data-astro-cid-7p2l4vwq>Wizualizacje 3D, plany aranżacyjne i szczegółowe <a href="/zestawienie-materialow" data-astro-cid-dd7xymsh>zestawienia materiałowe</a></li><li data-astro-cid-7p2l4vwq>Współpraca tylko z zaufanymi wykonawcami i dostawcami</li><li data-astro-cid-7p2l4vwq>Niezależnie czy mieszkasz w Warszawie, Gdyni czy Wrocławiu dopasujemy projekt do Twojej lokalizacji, budżetu i nieruchomości</li></ul><p class="narracja__cta" data-astro-cid-7p2l4vwq><a class="guzik guzik--glowny" href="/kontakt" data-astro-cid-7p2l4vwq>Skontaktuj się z nami</a></p></div><img src="/_astro/strony-glowna-portret-projektantki-13.BqQe7fyP_58Cqg.webp" srcset="/_astro/strony-glowna-portret-projektantki-13.BqQe7fyP_Z2j99vB.webp 480w, /_astro/strony-glowna-portret-projektantki-13.BqQe7fyP_5TGYV.webp 640w, /_astro/strony-glowna-portret-projektantki-13.BqQe7fyP_Z1uC9LJ.webp 800w, /_astro/strony-glowna-portret-projektantki-13.BqQe7fyP_58Cqg.webp 1012w" alt="Portret uśmiechniętej kobiety w koszuli w biało-niebieskie paski stojącej przy jasnym oknie" sizes="(min-width: 75rem) 503px, (min-width: 64rem) calc(50vw - 85px), (min-width: 48rem) calc(100vw - 104px), calc(100vw - 72px)" data-pelny="/_astro/strony-glowna-portret-projektantki-13.BqQe7fyP_1LK6Fw.webp" data-szer="1618" data-wys="1080" data-astro-cid-7p2l4vwq="true" loading="lazy" decoding="async" width="1012" height="602" class="narracja__zdjecie"></div></div></section></main><aside class="baner" id="baner-cena" aria-label="Kalkulatory kosztów projektu i remontu" data-stan="ukryty" data-astro-cid-dqusfuer><a class="baner__odnosnik" href="/cena" data-astro-cid-dqusfuer><svg class="baner__ikona" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-astro-cid-dqusfuer><rect x="5" y="3" width="14" height="18" rx="2" data-astro-cid-dqusfuer></rect><path d="M8 7h8M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01" data-astro-cid-dqusfuer></path></svg><span data-astro-cid-dqusfuer>Sprawdź koszt swojego projektu</span></a><button class="baner__zamknij" type="button" aria-label="Zamknij baner o kalkulatorach" data-astro-cid-dqusfuer><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-astro-cid-dqusfuer><path d="M6 6l12 12M18 6L6 18" data-astro-cid-dqusfuer></path></svg></button></aside><script type="module">var e=document.getElementById(`baner-cena`),t=`baner-cena`,n=!1;try{n=sessionStorage.getItem(t)===`1`}catch{}if(e&&!n){let n=document.documentElement,r=new Set,i=!1,a=()=>{let t=i&&(!r.size||e.contains(document.activeElement));e.dataset.stan=t?`widoczny`:`ukryty`},o=new IntersectionObserver(e=>{e.forEach(e=>e.isIntersecting?r.add(e.target):r.delete(e.target)),a()});document.querySelectorAll(`main form, footer`).forEach(e=>o.observe(e)),e.addEventListener(`focusin`,a),e.addEventListener(`focusout`,()=>setTimeout(a));let s=()=>n.scrollHeight-innerH